---
import Base from '../layouts/Base.astro';
import ListaEntradas from '../components/ListaEntradas.astro';
import { getEntry, render } from 'astro:content';
import { todas } from '../lib/entradas';
import { SECCIONES } from '../lib/nolugaria';

const portada = (await getEntry('paginas', 'portada'))!;
const { Content } = await render(portada);
const entradas = await todas();
const cuenta = (id: string) => entradas.filter((e) => e.data.secciones.includes(id as any)).length;
---
<Base title="No Lugaria" description="No Lugaria recopila experiencias utópicas en el arte y en la vida." inicio>
  <script is:inline>
    // Los enlaces antiguos del mapa eran /#suceso: ahora el mapa vive en /mapa/.
    if (location.hash.length > 1) location.replace('/mapa/' + location.hash);
  </script>
  <section class="nl-portada">
    <h1><img src="/nolugaria-logo.png" width="600" height="200" alt="No Lugaria. Utopías artísticas" /></h1>
    <div class="prose portada-texto"><Content /></div>
  </section>

  <h2>Secciones</h2>
  <ul class="secciones">
    {SECCIONES.map((s) => (
      <li><a href={s.ruta}><span class="nombre">{s.nombre}</span> <span class="n">{cuenta(s.id)}</span></a></li>
    ))}
    <li><a href="/mapa/"><span class="nombre">Mapa de revueltas, revoluciones y utopías</span></a></li>
  </ul>

  <h2>Entradas recientes</h2>
  <ListaEntradas entradas={entradas.slice(0, 8)} />
</Base>
