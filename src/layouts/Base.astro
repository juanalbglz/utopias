---
import '../styles/global.css';

import { SECCIONES } from '../lib/nolugaria';

interface Props { title: string; description: string; inicio?: boolean; actual?: string }
const { title, description, inicio, actual } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = 'https://juanalbglz.eu/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{inicio ? 'No Lugaria · Utopías artísticas' : `${title} · No Lugaria`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <link rel="preload" href={`${base}fonts/bricolage-grotesque-latin-800-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#efe6d2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151311" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="tinta"><feTurbulence type="fractalNoise" baseFrequency=".04" numOctaves="3" seed="7" result="t" /><feDisplacementMap in="SourceGraphic" in2="t" scale="4" /></filter>
    </svg>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={home}>Juan Alberto González</a>
        <nav aria-label="Principal">
          <a href={home}>Inicio</a>
          <a href={`${home}blog/`}>Blog</a>
          <a href="https://arthist.juanalbglz.eu/">Arthist</a>
          <a href={base} aria-current="page">Nolugaria</a>
          <a href="https://canarias.africa/">Canarias.Africa</a>
          <a href={`${home}#contacto`}>Contacto</a>
          <a href="https://mastodon.art/@juanalbglz" rel="me">Mastodon</a>
        </nav>
      </div>
    </header>
    <div class="nolugaria">
      <div class="wrap">
        <a class="nl-marca" href="/" aria-current={inicio ? 'page' : undefined}>
          <span class="nombre">No Lugaria</span>
          <span class="lema">Utopías artísticas</span>
        </a>
        <nav aria-label="Nolugaria">
          {SECCIONES.filter((s) => s.menu).map((s) => (
            <a href={s.ruta} aria-current={actual === s.id ? 'page' : undefined}>{s.nombre}</a>
          ))}
          <a href="/mapa/" aria-current={actual === 'mapa' ? 'page' : undefined}>Mapa</a>
          <a href="/participa/" aria-current={actual === 'participa' ? 'page' : undefined}>¡Participa!</a>
        </nav>
      </div>
    </div>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <span>No Lugaria, por nolugaria (œu-topia) · Textos bajo <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.es" rel="license">CC BY-SA 4.0</a>; cada imagen o vídeo enlazado conserva la licencia de su autoría · <a href="/creditos/">Créditos</a></span>
        <span>Mapa: datos de Juan Alberto González, <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> · Cartografía: <a href="https://www.naturalearthdata.com/">Natural Earth</a> (dominio público)</span>
        <span>Esta web no usa cookies, analítica ni rastreadores.</span>
      </div>
    </footer>
  </body>
</html>
